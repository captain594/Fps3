-- ===================================================
-- One-Tap FPS + Aimbot (Farthest Target) + Center FOV + ESP
-- Complete Script
-- ===================================================

-- 1. โหลด Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- 2. สร้าง Window หลัก
local Window = Rayfield:CreateWindow({
   Name = "One-Tap FPS Hub | Rayfield",
   LoadingTitle = "กำลังโหลดสคริปต์...",
   LoadingSubtitle = "by Assistant",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false
})

-- 3. ตั้งค่าบริการและตัวแปรหลัก
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Settings = {
    OneTapEnabled = true,
    AimbotEnabled = false,
    TargetPart = "Head",
    FOVSize = 150,
    ShowFOV = true,
    ESPEnabled = false
}

-- 4. สร้าง FOV Circle (ให้อยู่ตรงกลางหน้าจอนิ่งๆ)
local FOVCircle = Drawing.new("Circle")
FOVCircle.Color = Color3.fromRGB(255, 50, 50)
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 60
FOVCircle.Radius = Settings.FOVSize
FOVCircle.Filled = false
FOVCircle.Visible = Settings.ShowFOV

-- 5. สร้าง Tab บน Rayfield UI
local MainTab = Window:CreateTab("Main", 4483362458)
local AimTab = Window:CreateTab("Aimbot", 4483362458)
local VisualTab = Window:CreateTab("ESP (มองทะลุ)", 4483362458)

-- ==================== TAB 1: MAIN ====================
MainTab:CreateSection("One-Tap System")

MainTab:CreateToggle({
   Name = "Enable One-Tap Mode",
   CurrentValue = true,
   Callback = function(Value)
       Settings.OneTapEnabled = Value
   end,
})

-- ==================== TAB 2: AIMBOT ====================
AimTab:CreateSection("Aimbot Options (ล็อกคนที่ไกลที่สุด)")

AimTab:CreateToggle({
   Name = "Enable Aimbot (ล็อกเป้า)",
   CurrentValue = false,
   Callback = function(Value)
       Settings.AimbotEnabled = Value
   end,
})

AimTab:CreateDropdown({
   Name = "Target Part (ตำแหน่งที่จะล็อก)",
   Options = {"Head", "HumanoidRootPart"},
   CurrentOption = {"Head"},
   MultipleOptions = false,
   Callback = function(Option)
       Settings.TargetPart = Option[1]
   end,
})

AimTab:CreateToggle({
   Name = "Show FOV Circle (แสดงวงกลมกลางจอ)",
   CurrentValue = true,
   Callback = function(Value)
       Settings.ShowFOV = Value
       FOVCircle.Visible = Value
   end,
})

AimTab:CreateSlider({
   Name = "FOV Radius (ขนาดวงกลมกลางจอ)",
   Range = {50, 500},
   Increment = 10,
   CurrentValue = 150,
   Callback = function(Value)
       Settings.FOVSize = Value
       FOVCircle.Radius = Value
   end,
})

-- ==================== TAB 3: ESP ====================
VisualTab:CreateSection("Player ESP (แสดงตำแหน่งผู้เล่น)")

VisualTab:CreateToggle({
   Name = "Enable Wallhack ESP",
   CurrentValue = false,
   Callback = function(Value)
       Settings.ESPEnabled = Value
       if not Value then
           for _, plr in pairs(Players:GetPlayers()) do
               if plr.Character and plr.Character:FindFirstChild("ESPHighlight") then
                   plr.Character.ESPHighlight:Destroy()
               end
           end
       end
   end,
})

-- 6. ฟังก์ชันค้นหาศัตรูที่ "อยู่ไกลที่สุด" แต่ยังอยู่ในวงกลม FOV กลางหน้าจอ
local function GetFarthestPlayer()
    local farthestPlayer = nil
    local longestDistance = -1 -- เริ่มต้นหาตัวที่ไกลที่สุด

    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local targetPart = player.Character[Settings.TargetPart]
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            
            if onScreen then
                -- ระยะห่างบนหน้าจอเทียบกับจุดศูนย์กลางวงกลม
                local distanceFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                
                -- ตรวจสอบว่าเป้าหมายอยู่ในวงกลม FOV หรือไม่
                if distanceFromCenter <= Settings.FOVSize then
                    -- คำนวณระยะห่างจริงในเกม (3D Distance) เพื่อหาคนที่อยู่ไกลที่สุด
                    local worldDistance = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) 
                        and (targetPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude or 0
                    
                    if worldDistance > longestDistance then
                        longestDistance = worldDistance
                        farthestPlayer = targetPart
                    end
                end
            end
        end
    end
    return farthestPlayer
end

-- 7. Loop การทำงานหลักแบบ Real-time
RunService.RenderStepped:Connect(function()
    -- 1. ล็อกตำแหน่งวงกลม FOV ไว้ตรงกลางหน้าจอแบบนิ่งๆ
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    -- 2. ระบบ Aimbot ล็อกคนที่ไกลที่สุดเมื่อกดคลิกซ้าย
    if Settings.AimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        local target = GetFarthestPlayer()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end

    -- 3. ระบบ ESP มองทะลุกำแพง
    if Settings.ESPEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local char = plr.Character
                if not char:FindFirstChild("ESPHighlight") then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "ESPHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = char
                end
            end
        end
    end
end)

-- แจ้งเตือนเมื่อโหลดสำเร็จ
Rayfield:Notify({
   Title = "อัปเดตเรียบร้อย!",
   Content = "วงกลมนิ่งอยู่กลางจอ + ล็อกเป้าหมายที่ไกลที่สุดแล้ว",
   Duration = 3,
   Image = 4483362458,
})

